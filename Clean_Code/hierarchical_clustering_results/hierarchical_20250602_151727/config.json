{
  "levels": 3,
  "level_configs": {
    "1": {
      "use_cross_encoder": false,
      "min_cluster_size": 15,
      "min_samples": 1,
      "refine_after_clustering": false,
      "refinement_method": "borderline",
      "cluster_selection_method": "leaf",
      "cluster_selection_epsilon": 0.5
    },
    "2": {
      "use_cross_encoder": false,
      "min_cluster_size": 5,
      "min_samples": 3,
      "refine_after_clustering": true,
      "refinement_method": "borderline",
      "cluster_selection_method": "eom"
    },
    "3": {
      "use_cross_encoder": false,
      "min_cluster_size": 3,
      "min_samples": 2,
      "refine_after_clustering": true,
      "refinement_method": "borderline",
      "cluster_selection_method": "eom"
    }
  },
  "embedding": {
    "algorithm": "hdbscan",
    "min_cluster_size": 3,
    "min_samples": 2,
    "metric": "cosine",
    "cluster_selection_method": "eom",
    "prediction_data": true
  },
  "preprocessing": {
    "normalize": true,
    "normalize_method": "l2",
    "remove_outliers": false,
    "outlier_method": "zscore",
    "outlier_threshold": 3.0,
    "reduce_dimensions": false
  },
  "cross_encoder": {
    "use_refinement": true,
    "refinement_method": "borderline",
    "embedding_weight": 0.7,
    "cross_encoder_weight": 0.3,
    "confidence_threshold": 0.6,
    "batch_size": 32,
    "strict_validation": false,
    "model_name": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "device": null,
    "borderline_percentile": 20,
    "max_borderline_points": 100,
    "cache_similarities": true,
    "similarity_cache_dir": "similarity_cache"
  },
  "evaluation": {
    "compute_metrics": true,
    "analyze_clusters": true
  },
  "visualization": {
    "create_visualizations": true,
    "method": "umap",
    "dims": 2,
    "figsize": [
      12,
      8
    ],
    "save_plots": true,
    "umap": {
      "n_neighbors": 15,
      "min_dist": 0.1,
      "metric": "cosine"
    },
    "tsne": {
      "perplexity": 30,
      "learning_rate": 200,
      "iterations": 1000
    },
    "plot_style": "seaborn-v0_8-whitegrid",
    "noise_alpha": 0.3,
    "cluster_alpha": 0.7,
    "use_colormap": "tab20",
    "azimuth": 235,
    "elevation": 30
  },
  "output": {
    "save_results": true,
    "output_dir": "hierarchical_clustering_results",
    "save_model": false,
    "timestamp_directories": true,
    "export_csv": true,
    "export_json": true,
    "export_pickle": false,
    "save_embeddings": false,
    "save_refined_embeddings": false,
    "save_hierarchical_data": true,
    "save_cluster_metadata": true,
    "generate_html_report": false
  },
  "algorithm": "hdbscan",
  "metric": "cosine",
  "prediction_data": true,
  "default": {
    "min_cluster_size": 2,
    "min_samples": 1,
    "cluster_selection_method": "eom",
    "cluster_selection_epsilon": 0.0
  }
}